# Auto Battler Arena — environment configuration
# Copy to `.env` (or export these vars) and fill in real values.
# Do NOT commit a real .env file — it is gitignored.

# ── Security (REQUIRED in production) ────────────────────────────────────────

# Flask session signing key. MUST be a long random string in production, or
# sessions (and the safety gate) reset on every restart. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Access code for the safety gate (the login wall in front of the whole app).
# If unset, a random code is generated and printed to the console on each boot.
SAFETY_PASSWORD=

# Send the session cookie only over HTTPS. Leave false for local HTTP dev;
# set to true in production once served behind TLS.
SESSION_COOKIE_SECURE=false

# Comma-separated list of allowed cross-origin hosts for the API. Leave empty
# when the frontend is served from the same origin as the API (the default).
# Example: CORS_ORIGINS=https://game.example.com
CORS_ORIGINS=

# ── Database ─────────────────────────────────────────────────────────────────

# SQLAlchemy database URL. Defaults to a local SQLite file (instance/game.db).
# For real concurrency use PostgreSQL, e.g. postgresql://user:pass@host/dbname
DATABASE_URL=sqlite:///game.db

# ── Accounts / signup ────────────────────────────────────────────────────────

# Beta mode flags every new signup as a tester.
BETA_MODE=false
# Enable the invite-code signup endpoint.
SIGNUP_ENABLED=false

# ── Server ───────────────────────────────────────────────────────────────────

HOST=0.0.0.0
PORT=5000

# Never enable in production. Flask debug mode exposes an interactive debugger.
DEBUG=false

# Developer tooling (combat simulator, event/ghost editors, demo pages) and
# their APIs. Off by default; never enable on a public deployment.
ENABLE_DEV_ROUTES=false
